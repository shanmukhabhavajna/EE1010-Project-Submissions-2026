// ============================================
// PT100 THERMOMETER ENCLOSURE
// Dimensions in mm
// ============================================

length = 140;
width  = 100;
height = 70;

wall   = 3;
bottom = 3;

// LCD HEADER-PIN SLOT — FRONT WALL
lcd_width  = 48;
lcd_height = 2.5;
lcd_x = (length - lcd_width)/2;
lcd_z = 35;

// USB HOLE — RIGHT WALL
usb_width  = 14.5;
usb_height = 8;
usb_y = 30;
usb_z = 20;

// PT100 HOLE — BOTTOM
pt100_diameter = 5.5;

// ============================================
// BOX WITH ALL OPENINGS
// ============================================

difference() {
    // Outer box
    cube([length, width, height]);

    // Hollow interior — open top
    translate([wall, wall, bottom])
        cube([length - 2*wall,
              width - 2*wall,
              height]);

    // LCD header-pin slot — front wall
    translate([lcd_x, -0.1, lcd_z])
        cube([lcd_width, wall + 0.2, lcd_height]);

    // USB hole — right wall
    translate([length - wall - 0.1, usb_y, usb_z])
        cube([wall + 0.2, usb_width, usb_height]);

    // PT100 HOLE — CUT COMPLETELY THROUGH BOTTOM
    translate([length/2, width/2, -1])
        cylinder(d=pt100_diameter, h=bottom + 2, $fn=64);
}

// PERFBOARD SUPPORTS — FRONT INNER WALL
translate([(length-70)/2, wall, 8])
    cube([3, 5, 50]);

translate([(length-70)/2+67, wall, 8])
    cube([3, 5, 50]);

// ARDUINO SUPPORT — BACK INNER WALL
translate([(length-125)/2, width-wall-3, 3])
    cube([125, 3, 5]);